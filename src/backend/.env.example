# ============================================================
# RepoVue backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Comma-separated keys clients must send as: X-API-Key: <key>
API_KEYS=dev-local-key

# ---------- Database (Neon Postgres, needs pgvector) ----------
# Neon gives you a URL like:
#   postgresql://user:pass@ep-xxx.aws.neon.tech/repovue?sslmode=require
# Convert the scheme to postgresql+asyncpg:// and drop ?sslmode (asyncpg uses ssl=true)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/repovue
DB_SSL=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=8000
LLM_MAX_CONCURRENCY=4

# ---------- Embeddings ----------
# provider: voyage | openai | hash  (hash = offline deterministic fallback, dev only)
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---------- GitHub ----------
# Personal access token (repo scope) OR GitHub App credentials
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_NAME=repovue[bot]
GITHUB_BOT_EMAIL=repovue@users.noreply.github.com

# ---------- Workspace / limits ----------
WORKSPACE_DIR=/tmp/repovue
MAX_REPO_MB=300
MAX_FILE_KB=400
MAX_FILES_PER_ANALYSIS=4000
CLONE_TIMEOUT_SEC=300

# ---------- Docker validation sandbox ----------
VALIDATION_ENABLED=true
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_TIMEOUT_SEC=900
SANDBOX_NETWORK=none
BENCHMARK_RUNS=3
PERF_REGRESSION_TOLERANCE=0.05

# ---------- Jira ----------
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=REPO
JIRA_ISSUE_TYPE=Bug
JIRA_MIN_SEVERITY=high

# ---------- Worker ----------
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=3
